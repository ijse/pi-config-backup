    "npm:@narumitw/pi-subagents",
    "npm:pi-cache-optimizer",
    "npm:pi-open-tui",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:pi-observational-memory",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "/Users/liyi/.pi/agent/local-packages/pi-observational-memory-oauth-baseurl",
    "npm:pi-chrome",
    "npm:@tmustier/pi-files-widget",
    "npm:@almegal/pi-file-browser",
    "git:https://github.com/L2ncE/pi-btw",
    "npm:pi-session-summary",
    "git:https://github.com/Dovyski/pi-recap",
    "git:github.com/ijse/pi-model-router@v1.1.0"
